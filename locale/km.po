msgctxt "model:ir.message,text:menu_exist"
msgid ""
"This mailbox has already a menu.\n"
"Please, refresh the menu to see it."
msgstr ""
"ប្រអប់សំបុត្រនេះមានម៉ឺនុយរួចហើយ។\n"
"សូមធ្វើឱ្យម៉ឺនុយស្រស់ឡើងវិញដើម្បីមើលវា។"

msgctxt "model:ir.message,text:not_company"
msgid ""
"You have not got the default company configured. And you need it to configure"
" the default folders."
msgstr ""
"អ្នកមិនទាន់បានកំណត់ក្រុមហ៊ុនលំនាំដើមទេ។ សូមកំណត់វា ដើម្បីអាចកំណត់ថតលំនាំដើម។"

#, python-format
msgctxt "model:ir.message,text:not_validate_emails"
msgid ""
"Email is not list, set or string. Please, check the e-mail \"%(email)s\" "
"before to send."
msgstr ""
"អាសយដ្ឋានអ៊ីមែលត្រូវតែជាបញ្ជី សំណុំ ឬអត្ថបទ។ សូមពិនិត្យអ៊ីមែល «%(email)s» "
"មុននឹងផ្ញើ។"

